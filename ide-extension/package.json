{
  "name": "vps-workspaces",
  "displayName": "VPS Workspaces",
  "publisher": "drpod",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vpsWorkspaces.open",
        "title": "VPS Workspaces: Open Saved cmux Layout"
      },
      {
        "command": "vpsWorkspaces.share",
        "title": "VPS Workspaces: Copy Sharing Link"
      },
      {
        "command": "vpsWorkspaces.hapi",
        "title": "VPS Workspaces: Open HAPI Sessions"
      }
    ]
  },
  "scripts": {
    "build": "esbuild extension.ts --bundle --platform=node --external:vscode --minify --legal-comments=eof --outfile=dist/extension.js",
    "test": "npm run check && npm run build && esbuild layout.ts --bundle --platform=node --outfile=.test-build/layout.cjs && node --test layout.test.cjs",
    "check": "tsc && prettier --check extension.ts layout.ts layout.test.cjs tsconfig.json package.json",
    "format": "prettier --write extension.ts layout.ts layout.test.cjs tsconfig.json package.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "1.95",
    "esbuild": "0.25.10",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
